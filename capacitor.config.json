{
  "appId": "com.mesut.iptv",
  "appName": "Mesut IPTV",
  "webDir": "www",
  "backgroundColor": "#0a0a1c",
  "android": { "allowMixedContent": true },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a1c",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0a0a1c" }
  }
}
